# ── Supabase (public — safe to expose) ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ── Supabase Service Role (NEVER expose publicly — server-side only) ─────────
# Get from: Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ── GitHub Webhook Secret (optional but recommended) ─────────────────────────
# Any random string — must match what you set in GitHub webhook settings
GITHUB_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# ── GitHub Personal Access Token (optional — increases API rate limit) ────────
# Get from: GitHub → Settings → Developer settings → Personal access tokens
# Scopes needed: public_repo (read-only is fine)
GITHUB_TOKEN=YOUR_GITHUB_TOKEN

# ── Cron Secret (protects /api/cron/sync-all from unauthorized calls) ─────────
# Generate: openssl rand -hex 32  OR use any random string
# Add this same value to Vercel Environment Variables
CRON_SECRET=YOUR_CRON_SECRET
